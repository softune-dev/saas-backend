# Copy this to .env on the VM (never commit the real .env — .gitignore
# already blocks anything starting with ".env"). Fill in real values.

APP_ENV=production
DEBUG=false
PORT=8000

# Generate with: openssl rand -hex 32
SECRET_KEY=

# Supabase — same values already in your local .env
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Redis/RabbitMQ URLs are set directly in docker-compose.prod.yml (they
# point at the redis/rabbitmq service names on Docker's internal network) —
# only the RabbitMQ credentials need to be real here.
RABBITMQ_USER=
RABBITMQ_PASS=

CORS_ORIGINS=https://dashboard.softune.xyz
REVALIDATE_SECRET=
SITE_BASE_DOMAIN=softune.xyz

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

COURIER_CREDENTIALS_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@softune.xyz

GEMINI_API_KEY=

VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
