# Copy this to .env on the VM (never commit the real .env — .gitignore
# already blocks anything starting with ".env"). Fill in real values.

APP_ENV=production
DEBUG=false
PORT=8000

# Generate with: openssl rand -hex 32
SECRET_KEY=

# Supabase — same values already in your local .env
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Redis/RabbitMQ URLs are set directly in docker-compose.prod.yml (they
# point at the redis/rabbitmq service names on Docker's internal network) —
# only the RabbitMQ credentials need to be real here.
RABBITMQ_USER=
RABBITMQ_PASS=

CORS_ORIGINS=https://dashboard.softunebd.com
REVALIDATE_SECRET=
SITE_BASE_DOMAIN=softunebd.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

COURIER_CREDENTIALS_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@softunebd.com

GEMINI_API_KEY=

VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

API_BASE_URL=https://api.softunebd.com

# Hostinger SMTP for the support@softunebd.com mailbox — used for the trial
# signup OTP email (app/mailer.py).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=support@softunebd.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@softunebd.com
SMTP_FROM_NAME=Softune

# reCAPTCHA — if RECAPTCHA_SECRET_KEY is blank, login/checkout/contact/
# signup bot protection is silently DISABLED (app/recaptcha.py). Required.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_V2_SECRET_KEY=

# Bearer secret the SMS-forwarding phone sends to /public/webhooks/bkash-sms.
# Generate with: openssl rand -hex 32
BKASH_SMS_WEBHOOK_SECRET=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Must be a dedicated account on a plan="demo" tenant — /public/demo-access
# hands its login to anyone. Never a real owner's or superadmin's address
# (the endpoint now refuses those, and demo access will just be unavailable).
DEMO_USER_EMAIL=


TRIAL_SIGNUP_TTL_MINUTES=45
TRIAL_DAYS=7
TRIAL_GRACE_DAYS=4
