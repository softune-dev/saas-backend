# Copy this to .env on the VM (never commit the real .env — .gitignore
# already blocks anything starting with ".env"). Fill in real values.

APP_ENV=production
DEBUG=false
PORT=8000

# Generate with: openssl rand -hex 32
SECRET_KEY=

# Supabase — same values already in your local .env
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Redis/RabbitMQ URLs are set directly in docker-compose.prod.yml (they
# point at the redis/rabbitmq service names on Docker's internal network) —
# only the RabbitMQ credentials need to be real here.
RABBITMQ_USER=
RABBITMQ_PASS=

CORS_ORIGINS=https://dashboard.softunebd.com
REVALIDATE_SECRET=
SITE_BASE_DOMAIN=softunebd.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

COURIER_CREDENTIALS_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@softunebd.com

GEMINI_API_KEY=

VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

API_BASE_URL=https://api.softunebd.com

# Hostinger SMTP for the support@softunebd.com mailbox — used for the lead
# signup OTP email and purchase-request notifications (app/mailer.py).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=support@softunebd.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@softunebd.com
SMTP_FROM_NAME=Softune

# Which real demo (plan="demo") account a lead gets a token for when they
# click "See a live demo" — see app/api/leads.py's demo_access.
DEMO_USER_EMAIL=kallol.business.ds@gmail.com

# wa.me deep link number, digits only with country code, no "+". Blank
# means the frontend just doesn't show a WhatsApp option on purchase-request.
WHATSAPP_BUSINESS_NUMBER=8801831624571
